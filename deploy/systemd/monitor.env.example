XS_MONITOR_OUTPUT_DIR=/var/lib/xs-nexus-monitor
XS_MONITOR_STATE_FILE=/var/lib/xs-nexus-monitor/state.json
XS_MONITOR_SOURCE_ID=xs-nexus-production

XS_MONITOR_DISK_PATHS="/"
XS_MONITOR_DISK_WARNING_PERCENT=80
XS_MONITOR_DISK_CRITICAL_PERCENT=90
XS_MONITOR_INODE_WARNING=80
XS_MONITOR_INODE_CRITICAL=90
XS_MONITOR_CPU_WARNING=90
XS_MONITOR_CPU_CRITICAL=98
XS_MONITOR_MEMORY_WARNING=85
XS_MONITOR_MEMORY_CRITICAL=95
XS_MONITOR_FD_WARNING=80
XS_MONITOR_FD_CRITICAL=90
XS_MONITOR_TASK_WARNING=1000
XS_MONITOR_TASK_CRITICAL=2000
XS_MONITOR_LOG_BYTES_WARNING=104857600
XS_MONITOR_LOG_BYTES_CRITICAL=524288000
XS_MONITOR_LOG_ENTRY_LIMIT=10000
XS_MONITOR_LOG_PATHS=""

XS_MONITOR_CONTAINERS="xs-nexus-controller xs-nexus-relay xs-nexus-console"
XS_MONITOR_HEALTH_URLS="http://127.0.0.1:28080/health http://127.0.0.1:28081/"
XS_MONITOR_CONTROLLER_OBSERVABILITY_URL=http://127.0.0.1:28080/v1/admin/observability
XS_MONITOR_CONTROLLER_TOKEN_FILE=/etc/xs-nexus/monitor-controller.token
XS_MONITOR_MINIMUM_ONLINE_NODES=1

XS_MONITOR_HANDSHAKE_FAILURES_WARNING=10
XS_MONITOR_HANDSHAKE_FAILURES_CRITICAL=100
XS_MONITOR_AUTH_FAILURES_WARNING=5
XS_MONITOR_AUTH_FAILURES_CRITICAL=20
XS_MONITOR_REPLAY_DROPS_WARNING=1
XS_MONITOR_REPLAY_DROPS_CRITICAL=10
XS_MONITOR_ACL_DROPS_WARNING=100
XS_MONITOR_ACL_DROPS_CRITICAL=1000
XS_MONITOR_RELAY_ABUSE_WARNING=100
XS_MONITOR_RELAY_ABUSE_CRITICAL=1000

XS_MONITOR_BACKUP_DIR=/var/backups/xs-nexus/rc
XS_MONITOR_BACKUP_MAX_AGE_SECONDS=93600
XS_MONITOR_BACKUP_COPY_RECEIPT=/var/lib/xs-nexus-monitor/backup-copy-receipt.json
XS_MONITOR_BACKUP_COPY_MAX_AGE_SECONDS=93600
XS_MONITOR_BACKUP_DEEP_VERIFY_RECEIPT=/var/lib/xs-nexus-monitor/backup-deep-verification.json
XS_MONITOR_BACKUP_DEEP_MAX_AGE_SECONDS=604800

XS_MONITOR_TLS_TARGETS="vpn.example.com:443"
XS_MONITOR_TLS_WARNING_SECONDS=2592000
XS_MONITOR_TLS_CRITICAL_SECONDS=1209600

XS_MONITOR_WEBHOOK_URL=https://monitoring.example.com/v1/xs-nexus-alerts
XS_MONITOR_WEBHOOK_TOKEN_FILE=/etc/xs-nexus/monitor-webhook.token
