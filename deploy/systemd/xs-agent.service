[Unit]
Description=XS Nexus Linux Agent
Documentation=file:/usr/local/lib/xs-nexus/current/share/doc/xs-nexus/LINUX_INSTALLATION.md
Wants=network-online.target
After=network-online.target
ConditionPathIsReadWrite=/dev/net/tun
ConditionPathExists=/etc/xs-nexus/agent.json
ConditionPathExists=/var/lib/xs-nexus/node-state.json

[Service]
Type=simple
User=xs-nexus
Group=xs-nexus
ExecStart=/usr/local/lib/xs-nexus/current/bin/xs-agent run --config /etc/xs-nexus/agent.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077
StateDirectory=xs-nexus
StateDirectoryMode=0700
RuntimeDirectory=xs-nexus
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
PrivateDevices=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
