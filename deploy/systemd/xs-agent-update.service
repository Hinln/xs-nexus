[Unit]
Description=XS Nexus signed Agent update application
Documentation=file:/usr/local/lib/xs-nexus/current/share/doc/xs-nexus/LINUX_INSTALLATION.md
ConditionPathExists=/var/lib/xs-nexus/update-request.json
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/xs-nexus/current/bin/xs-agent apply-staged-update --config /etc/xs-nexus/agent.json --installer /usr/local/lib/xs-nexus/current/share/xs-nexus/xs-nexus-installer.sh
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/usr/local/lib/xs-nexus /usr/local/bin /etc/systemd/system /var/lib/xs-nexus /run/lock -/run/xs-nexus-update
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
SystemCallArchitectures=native
TasksMax=64
LimitNOFILE=256
