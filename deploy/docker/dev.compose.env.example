XS_DEPLOYMENT=dev
XS_COMPOSE_PROJECT_NAME=xs-nexus-dev
XS_RELEASE_REVISION=dev
XS_CONTROLLER_IMAGE=xs-nexus/controller:dev
XS_MIGRATION_IMAGE=xs-nexus/controller:dev
XS_RELAY_IMAGE=xs-nexus/relay:dev
XS_CONSOLE_IMAGE=xs-nexus/console:dev
XS_DB_TOOLS_IMAGE=xs-nexus/db-tools:dev
XS_CONTROLLER_SECRETS_DIR=/etc/xs-nexus/deployments/dev/controller
XS_LINUX_RELEASE_DIR=/var/lib/xs-nexus-releases/dev/linux/stable
XS_RELAY_SECRETS_DIR=/etc/xs-nexus/deployments/dev/relay
XS_BACKUP_DIR=/var/backups/xs-nexus/dev
XS_BACKUP_REPLICA_DIR=/mnt/xs-nexus-offsite/dev
XS_BACKUP_LOCAL_RETENTION_DAYS=30
XS_BACKUP_REPLICA_RETENTION_DAYS=180
XS_BACKUP_MIN_RETAINED=3
XS_STATE_DIR=/var/lib/xs-nexus-deploy/dev
XS_DATABASE_SCHEMA=xs_nexus_dev
XS_BIND_ADDRESS=127.0.0.1
XS_UDP_BIND_ADDRESS=127.0.0.1
XS_CONTROLLER_HTTP_PORT=18080
XS_CONSOLE_HTTP_PORT=18081
XS_DISCOVERY_UDP_PORT=42000
XS_RELAY_UDP_PORT=42001
XS_DISCOVERY_PUBLIC_ENDPOINT=127.0.0.1:42000
XS_RELAY_ID_BASE64=CHANGE_ME
XS_CONSOLE_COOKIE_SECURE=false
XS_RUST_LOG=info
XS_EDGE_IMAGE=xs-nexus/edge:dev
XS_EDGE_CONFIG_FILE=/etc/xs-nexus/deployments/dev/Caddyfile
XS_EDGE_DATA_DIR=/var/lib/xs-nexus-deploy/dev/edge
XS_EDGE_BIND_ADDRESS=0.0.0.0
XS_EDGE_HTTP_PORT=80
XS_EDGE_HTTPS_PORT=443
