XS_DEPLOYMENT=rc
XS_COMPOSE_PROJECT_NAME=xs-nexus-rc
XS_RELEASE_REVISION=REPLACE_WITH_CLEAN_GIT_COMMIT
XS_RELEASE_VERSION=0.1.0
XS_SOURCE_URL=https://github.com/Hinln/xs-nexus
XS_CONTROLLER_IMAGE=xs-nexus/controller:REPLACE_WITH_CLEAN_GIT_COMMIT
XS_MIGRATION_IMAGE=xs-nexus/controller:REPLACE_WITH_CLEAN_GIT_COMMIT
XS_RELAY_IMAGE=xs-nexus/relay:REPLACE_WITH_CLEAN_GIT_COMMIT
XS_CONSOLE_IMAGE=xs-nexus/console:REPLACE_WITH_CLEAN_GIT_COMMIT
XS_DB_TOOLS_IMAGE=xs-nexus/db-tools:REPLACE_WITH_CLEAN_GIT_COMMIT
XS_CONTROLLER_SECRETS_DIR=/etc/xs-nexus/deployments/rc/controller
XS_DATABASE_SECRETS_DIR=/etc/xs-nexus/deployments/rc/database
XS_LINUX_RELEASE_DIR=/var/lib/xs-nexus-releases/rc/linux/stable
XS_WINDOWS_RELEASE_DIR=/var/lib/xs-nexus-releases/rc/windows/stable
XS_RELAY_SECRETS_DIR=/etc/xs-nexus/deployments/rc/relay
XS_BACKUP_DIR=/var/backups/xs-nexus/rc
XS_BACKUP_REPLICA_DIR=/mnt/xs-nexus-offsite/rc
XS_BACKUP_LOCAL_RETENTION_DAYS=30
XS_BACKUP_REPLICA_RETENTION_DAYS=180
XS_BACKUP_MIN_RETAINED=3
XS_STATE_DIR=/var/lib/xs-nexus-deploy/rc
XS_DATABASE_SCHEMA=xs_nexus_rc
XS_DATABASE_APP_ROLE=xs_nexus_app
XS_DATABASE_OWNER_ROLE=xs_nexus_owner
XS_CONSOLE_BOOTSTRAP_USERNAME=
XS_CONSOLE_BOOTSTRAP_PASSWORD_FILE=
XS_BIND_ADDRESS=127.0.0.1
XS_UDP_BIND_ADDRESS=127.0.0.1
XS_CONTROLLER_HTTP_PORT=28080
XS_CONSOLE_HTTP_PORT=28081
XS_DISCOVERY_UDP_PORT=42100
XS_RELAY_UDP_PORT=42101
XS_DISCOVERY_PUBLIC_ENDPOINT=127.0.0.1:42100
XS_RELAY_ID_BASE64=CHANGE_ME
XS_CONSOLE_COOKIE_SECURE=true
XS_MAX_NODES_PER_NETWORK=1000
XS_MAX_CONTROL_SESSIONS=1000
XS_CONFIGURATION_SEND_CONCURRENCY=64
XS_RUST_LOG=info
XS_EDGE_IMAGE=xs-nexus/edge:REPLACE_WITH_CLEAN_GIT_COMMIT
XS_EDGE_CONFIG_FILE=/etc/xs-nexus/deployments/rc/Caddyfile
XS_EDGE_DATA_DIR=/var/lib/xs-nexus-deploy/rc/edge
XS_EDGE_BIND_ADDRESS=0.0.0.0
XS_EDGE_HTTP_PORT=80
XS_EDGE_HTTPS_PORT=443
