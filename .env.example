# 仅为模板。不要把真实密码提交到 Git。

APP_ENV=development
RUST_LOG=info
PUBLIC_BASE_URL=https://vpn.example.com
CONTROLLER_LISTEN=0.0.0.0:8080
RELAY_UDP_LISTEN=0.0.0.0:3478
CONSOLE_LISTEN=0.0.0.0:3000

DATABASE_URL=postgresql://XS_DB_USER:CHANGE_ME@1Panel-postgresql-AVyu:5432/XS_DB_NAME
DATABASE_SCHEMA=xs_nexus
REDIS_URL=redis://:CHANGE_ME@1Panel-redis-7ZP2:6379

# 必须随机生成
SESSION_SECRET=CHANGE_ME
ADMIN_API_TOKEN=CHANGE_ME
NODE_CREDENTIAL_TTL_SECONDS=2592000
CREDENTIAL_SIGNING_KEY_PATH=/run/secrets/credential_signing_key
CONFIG_SIGNING_KEY_PATH=/run/secrets/config_signing_key
CONTROLLER_TLS_CERT_PATH=/run/secrets/controller_tls_cert
CONTROLLER_TLS_KEY_PATH=/run/secrets/controller_tls_key

# 更新验证公钥，不是私钥
UPDATE_VERIFY_PUBLIC_KEY_PATH=/etc/xs-nexus/update-public-key.pem

# 不要在此放置 Enrollment Token、节点私钥、更新签名私钥
