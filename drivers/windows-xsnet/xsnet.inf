[Version]
Signature="$Windows NT$"
Class=Net
ClassGuid={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=xsnet.cat
DriverVer=07/31/2026,0.6.1.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...26100

[Standard.NTamd64.10.0...26100]
%DeviceDescription%=Xsnet_Install,Root\XSNET

[Xsnet_Install.NT]
Include=WUDFRD.inf,netcxrd.inf
Needs=WUDFRD.NT,netcxrd_Filter.NT
CopyFiles=Xsnet_CopyFiles
AddReg=Xsnet_Ndi
Characteristics=0x1
BusType=15
*IfType=6
*MediaType=0
*PhysicalMediaType=0
EnableDhcp=0
*IfConnectorPresent=0
*ConnectionType=1
*DirectionType=0
*AccessType=2
*HardwareLoopback=0

[Xsnet_Ndi]
HKR,Ndi,Service,0,"xsnet"
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"ethernet"

[Xsnet_Install.NT.HW]
Include=WUDFRD.inf,netcxrd.inf
Needs=WUDFRD.NT.HW,netcxrd_Filter.NT.HW
AddReg=Xsnet_DeviceSecurity

[Xsnet_DeviceSecurity]
HKR,,Security,,"D:P(A;;GA;;;SY)"
HKR,,Exclusive,0x00010001,1

[Xsnet_Install.NT.Services]
Include=WUDFRD.inf,netcxrd.inf
Needs=WUDFRD.NT.Services,netcxrd_Filter.NT.Services

[Xsnet_Install.NT.Filters]
Include=netcxrd.inf
Needs=netcxrd_Filter.NT.Filters

[Xsnet_Install.NT.Wdf]
UmdfService=xsnet,Xsnet_UmdfService
UmdfServiceOrder=xsnet
UmdfHostProcessSharing=ProcessSharingDisabled
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=RejectNullAndUnknownFileObjects
UmdfFsContextUsePolicy=CanUseFsContext2
UmdfDirectHardwareAccess=RejectDirectHardwareAccess

[Xsnet_UmdfService]
UmdfLibraryVersion=2.33
ServiceBinary=%13%\xsnet.dll
UmdfExtensions=NetAdapterCx0202

[DestinationDirs]
Xsnet_CopyFiles=13

[Xsnet_CopyFiles]
xsnet.dll

[SourceDisksFiles]
xsnet.dll=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
ProviderName="XS Nexus"
ManufacturerName="XS Nexus"
DeviceDescription="XS Nexus Virtual IPv4 Adapter"
DiskName="XS Nexus Driver Package"
